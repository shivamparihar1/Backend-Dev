<!DOCTYPE html>
<html>
<body>

<h1>Add new Student</h1>

<form action="/students/register" method="POST">
    <input type="text" name="name" placeholder="Enter Name" required>

    <select name="branch">
        <option value="CSE">CSE</option>
        <option value="Civil">Civil</option>
        <option value="Mechanical">Mechanical</option> 
        <option value="AI ML">AI ML</option> 
    </select>

    <button type="submit">Submit</button>
</form>

<hr>

<h2>Total Students: <%= total %></h2>

<h3>Filter By Branch</h3>
<a href="/">All</a> |
<a href="/?branch=CSE">CSE</a> |
<a href="/?branch=Civil">Civil</a> |
<a href="/?branch=Mechanical">Mechanical</a> |
<a href="/?branch=AI ML">AI ML</a>

<hr>

<h3>Current Students</h3>

<% if(allStudents.length === 0){ %>
    <h2>No students registered</h2>
<% } else { %>

<table border="1" cellpadding="10">
    <tr>
        <th>Name</th>
        <th>Branch</th>
        <th>Action</th>
    </tr>

    <% allStudents.forEach(s => { %>
        <tr>
            <td><%= s.name %></td>
            <td><%= s.branch %></td>
            <td>
                <a href="/students/delete/<%= s.id %>">Delete</a>
            </td>
        </tr>
    <% }) %>
</table>

<% } %>

</body>
</html>
